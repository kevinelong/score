    <!-- HOME: white on half-saturated green (4.6:1) -->
    <color name="home_bg">#FF4B805F</color>
    <color name="home_text">#FFFFFFFF</color>

    <!-- AWAY: half-saturated mustard on half-saturated tomato (4.0:1) -->
    <color name="away_bg">#FF99635B</color>
    <color name="away_text">#FFFFE8A4</color>

